import requests
from bs4 import BeautifulSoup
import time
from typing import List, Dict, Any


def scrape_events(date_from: str, date_to: str, pages: int = 3) -> List[Dict[str, Any]]:
    """
    Scrapes economic events (CPI, NFP, etc.) for a given date range.
    automatically cleans 'bull3' -> '3' for impact scoring.
    """
    url = "https://www.investing.com/economic-calendar/Service/getCalendarFilteredData"
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/121.0.0.0 Safari/537.36",
        "X-Requested-With": "XMLHttpRequest",
        "Referer": "https://www.investing.com/economic-calendar/",
    }

    all_events = []
    seen_pids = set()

    print(f"--- Starting Events Scrape ({date_from} to {date_to}) ---")

    for page in range(pages):
        payload = {
            "dateFrom": date_from,
            "dateTo": date_to,
            "timeZone": "8",  # Europe/London
            "currentTab": "custom",
            "limit_from": str(page),
            "submitFilters": "1"
        }

        try:
            print(f"Fetching Events Page {page}...")
            response = requests.post(url, data=payload, headers=headers, timeout=30)
            data_json = response.json()
            html_fragment = data_json.get('data', '')

            if not html_fragment:
                break

            soup = BeautifulSoup(html_fragment, 'html.parser')
            rows = soup.find_all("tr", class_="js-event-item")

            for row in rows:
                pid = row.get("id", "").replace("eventRowId_", "")
                if pid and pid not in seen_pids:
                    seen_pids.add(pid)

                    # --- IMPACT CLEANING LOGIC ---
                    # Extract raw value (e.g., "bull3", "grayFull")
                    raw_impact = "1"  # Default to low
                    sentiment_td = row.find("td", class_="sentiment")
                    if sentiment_td:
                        raw_str = sentiment_td.get("data-img_key", "")
                        # Remove "bull" to get "1", "2", "3"
                        # "grayFull" is usually a holiday or non-event, mapped to 0 or 1
                        clean_impact = raw_str.replace("bull", "").replace("grayFull", "0")

                        if clean_impact.isdigit():
                            raw_impact = clean_impact

                    all_events.append({
                        "pid": pid,
                        "title": row.find("td", class_="event").get_text(strip=True) if row.find("td",
                                                                                                 class_="event") else "N/A",
                        "impact_raw": raw_impact,  # Now stores "1", "2", "3"
                        "currency": row.find("td", class_="flagCur").get_text(strip=True) if row.find("td",
                                                                                                      class_="flagCur") else "",
                        "actual": row.find("td", class_="bold").get_text(strip=True) if row.find("td",
                                                                                                 class_="bold") else "",
                        "forecast": row.find("td", class_="fore").get_text(strip=True) if row.find("td",
                                                                                                   class_="fore") else "",
                        "previous": row.find("td", class_="prev").get_text(strip=True) if row.find("td",
                                                                                                   class_="prev") else "",
                        "time_raw": row.find("td", class_="js-time").get_text(strip=True) if row.find("td",
                                                                                                      class_="js-time") else ""
                    })
            time.sleep(1)

        except Exception as e:
            print(f"Event scrape failed on page {page}: {e}")
            break

    return all_events


