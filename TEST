from sqlalchemy import String, Integer, DateTime, Text, func
from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column
from datetime import datetime


class Base(DeclarativeBase):
    """Base class for all SQLAlchemy models."""
    pass


class EventRecord(Base):
    """
    Stores economic events (e.g., CPI, NFP).
    The 'pid' is the unique identifier from the source.
    """
    __tablename__ = "events"

    # Primary Key provided by the source
    pid: Mapped[str] = mapped_column(String, primary_key=True)

    # Core Data
    date: Mapped[str] = mapped_column(String, index=True)  # e.g., "2026-01-12"
    title: Mapped[str] = mapped_column(String, index=True)
    currency: Mapped[str] = mapped_column(String(10))
    impact: Mapped[str] = mapped_column(String(10))  # "1", "2", "3"
    time_str: Mapped[str] = mapped_column(String)  # "08:30" or "Tentative"

    # Numeric/Value Fields - Stored as strings to preserve formatting (e.g. "5.2%")
    actual: Mapped[str] = mapped_column(String, nullable=True)
    forecast: Mapped[str] = mapped_column(String, nullable=True)
    previous: Mapped[str] = mapped_column(String, nullable=True)

    # Source Tracking
    source: Mapped[str] = mapped_column(String, default="Investing.com")
    source_url: Mapped[str] = mapped_column(String, default="https://uk.investing.com/economic-calendar")

    # Metadata
    last_updated: Mapped[datetime] = mapped_column(DateTime, server_default=func.now(), onupdate=func.now())


class HolidayRecord(Base):
    """Stores market holidays."""
    __tablename__ = "holidays"

    # Composite PID: date-country-market-title
    pid: Mapped[str] = mapped_column(String, primary_key=True)

    date_str: Mapped[str] = mapped_column(String, index=True)
    country: Mapped[str] = mapped_column(String, index=True)
    market: Mapped[str] = mapped_column(String)
    title: Mapped[str] = mapped_column(String)
    status: Mapped[str] = mapped_column(String)

    # Source Tracking
    source: Mapped[str] = mapped_column(String, default="Investing.com")
    source_url: Mapped[str] = mapped_column(String, default="https://uk.investing.com/holiday-calendar/")

    first_seen_utc: Mapped[datetime] = mapped_column(DateTime, server_default=func.now())
    last_seen_utc: Mapped[datetime] = mapped_column(DateTime, server_default=func.now(), onupdate=func.now())


class CountryReference(Base):
    """Reference table for G7 priority and ISO mapping."""
    __tablename__ = "country_reference"

    country_name: Mapped[str] = mapped_column(String, primary_key=True)
    iso_code: Mapped[str] = mapped_column(String(3))
    country_priority: Mapped[int] = mapped_column(Integer, default=3)
    currency: Mapped[str] = mapped_column(String(5))
    currency_name: Mapped[str] = mapped_column(String)
    currency_priority: Mapped[int] = mapped_column(Integer, default=3)
    updated_at: Mapped[datetime] = mapped_column(DateTime, server_default=func.now(), onupdate=func.now())


class AuditLog(Base):
    """
    Granular history of field changes.
    Tracks 'Release' (new value) vs 'Revision' (correction).
    """
    __tablename__ = "audit_log"

    id: Mapped[int] = mapped_column(Integer, primary_key=True, autoincrement=True)
    event_pid: Mapped[str] = mapped_column(String, index=True)

    # Enum-like: INSERT, UPDATE, RELEASE, REVISION
    change_type: Mapped[str] = mapped_column(String)
    field_changed: Mapped[str] = mapped_column(String)

    old_value: Mapped[str] = mapped_column(String, nullable=True)
    new_value: Mapped[str] = mapped_column(String, nullable=True)

    detected_at_utc: Mapped[datetime] = mapped_column(DateTime, server_default=func.now())
    job_run_id: Mapped[str] = mapped_column(String, index=True)


class JobLog(Base):
    """
    High-level summary of scraper execution.
    """
    __tablename__ = "job_logs"

    id: Mapped[int] = mapped_column(Integer, primary_key=True, autoincrement=True)
    run_id: Mapped[str] = mapped_column(String, unique=True)  # UUID
    status: Mapped[str] = mapped_column(String)  # SUCCESS, FAILED

    # Why did this job run? (BOOTSTRAP, SNIPER, PATROL, DYNAMIC_ADD)
    trigger_reason: Mapped[str] = mapped_column(String, nullable=True)

    # Health Metrics
    events_added: Mapped[int] = mapped_column(Integer, default=0)
    events_updated: Mapped[int] = mapped_column(Integer, default=0)
    rows_omitted: Mapped[int] = mapped_column(Integer, default=0)  # Rows examined but unchanged

    error_message: Mapped[str] = mapped_column(Text, nullable=True)
    start_time_utc: Mapped[datetime] = mapped_column(DateTime, server_default=func.now())
    end_time_utc: Mapped[datetime] = mapped_column(DateTime, nullable=True)

