    sys.exit(1)

logger = get_logger("AdaptiveScheduler")

# --- SCHEDULER CONFIG ---
jobstores = {
    'default': SQLAlchemyJobStore(url=DB_URL)
}
executors = {
    'default': ThreadPoolExecutor(20)
}
job_defaults = {
    'coalesce': True,
    'max_instances': 1
}

scheduler = BackgroundScheduler(jobstores=jobstores, executors=executors, job_defaults=job_defaults)


def log_full_schedule_report():
    """
    Generates a single, merged chronological timeline of ALL system activity.
    Combines:
      1. Routine Jobs (Patrols, Bootstraps from APScheduler)
      2. Dynamic Targets (Upcoming Data Releases from DB)
    """
    service = PersistenceService()
    try:
        timeline = []
        now = datetime.now()
        lookahead_window = now + timedelta(hours=24)

        # --- 1. FETCH ROUTINE JOBS (Scheduler) ---
        routine_jobs = scheduler.get_jobs()
        for job in routine_jobs:
            if not job.next_run_time:
                continue
            if 'dynamic' in job.id:
                continue

            timeline.append({
                'time': job.next_run_time.replace(tzinfo=None),
                'type': 'ROUTINE',
                'label': f"System Task: {job.id} ({job.trigger})"
            })

        # --- 2. FETCH DYNAMIC TARGETS (Database) ---
        today_str = now.strftime("%Y-%m-%d")
        tomorrow_str = lookahead_window.strftime("%Y-%m-%d")

        records = service.session.query(EventRecord).filter(
            EventRecord.date.in_([today_str, tomorrow_str]),
            EventRecord.time_str.like("%:%")
        ).all()

        grouped_dynamic_targets: Dict[datetime, List[str]] = {}

        for r in records:
            try:
                event_dt = datetime.strptime(f"{r.date} {r.time_str}", "%Y-%m-%d %H:%M")
                trigger_dt = event_dt + timedelta(seconds=30)

                if now < trigger_dt <= lookahead_window:
                    if trigger_dt not in grouped_dynamic_targets:
                        grouped_dynamic_targets[trigger_dt] = []
                    grouped_dynamic_targets[trigger_dt].append(f"{r.title} ({r.currency})")
            except:
                continue

        for trigger_dt, events in grouped_dynamic_targets.items():
            if len(events) > 3:
                desc = f"{events[0]}, {events[1]} + {len(events) - 2} others"
            else:
                desc = ", ".join(events)

            timeline.append({
                'time': trigger_dt,
                'type': 'DYNAMIC',
                'label': f"Targeting {len(events)} Events: {desc}"
            })

        # --- 3. SORT & DISPLAY ---
        timeline.sort(key=lambda x: x['time'])

        logger.info("\n=== 24-HOUR OPERATIONS TIMELINE ===")
        if not timeline:
            logger.info("  No jobs scheduled for the next 24 hours.")

        for item in timeline:
            ts = item['time']
            day_label = "Today" if ts.date() == now.date() else "Tomorrow"
            time_str = ts.strftime("%H:%M:%S")
            type_tag = f"[{item['type']}]"

            logger.info(f"  {day_label} {time_str} | {type_tag:<8} {item['label']}")

        logger.info("===================================\n")

    except Exception as e:
        logger.error(f"Failed to generate schedule report: {e}")
    finally:
        service.close()


def execute_scrape_job(trigger_reason: str):
    logger.info(f"--- EXECUTION START | Reason: {trigger_reason} ---")
    service = PersistenceService()

    try:
        today = date.today()
        start_date = today - timedelta(days=3)
        end_date = today + timedelta(days=21)

        events = scrape_events(date_from=str(start_date), date_to=str(end_date), pages=5)

        if events:
            run_id, new_times = service.upsert_events_with_audit(events, trigger_reason=trigger_reason)

            if new_times:
                logger.info(f"FEEDBACK LOOP: Detected {len(new_times)} new confirmed times. Adjusting schedule...")
                schedule_dynamic_jobs(new_times)
            else:
                logger.info(f"Events Sync Complete (Run {run_id}).")

            if trigger_reason in ['PATROL', 'MANUAL']:
                log_full_schedule_report()

        else:
            logger.warning("Scraper returned 0 events.")

    except Exception as e:
        logger.error(f"Execution Failed: {e}", exc_info=True)
    finally:
        service.close()
        logger.info("--- EXECUTION END ---")


def schedule_dynamic_jobs(dt_list: List[datetime]):
    if not dt_list: return

    targets = [dt + timedelta(seconds=30) for dt in dt_list]
    targets.sort()

    clustered_times = []
    if targets:
        current_cluster_time = targets[0]
        for i in range(1, len(targets)):
            if (targets[i] - current_cluster_time).total_seconds() > 120:
                clustered_times.append(current_cluster_time)
                current_cluster_time = targets[i]
            else:
                current_cluster_time = max(current_cluster_time, targets[i])
        clustered_times.append(current_cluster_time)

    count = 0
    now = datetime.now()

    for run_time in clustered_times:
        if run_time > now:
            job_id = f"dynamic_{run_time.strftime('%Y%m%d_%H%M%S')}"
            try:
                scheduler.add_job(
                    execute_scrape_job,
                    'date',
                    run_date=run_time,
                    args=['DYNAMIC'],
                    id=job_id,
                    replace_existing=True
                )
                count += 1
            except Exception as e:
                logger.warning(f"Could not schedule dynamic job {job_id}: {e}")

    if count > 0:
        logger.info(f"DYNAMIC STRATEGY: Consolidated and scheduled {count} distinct target windows.")


def run_bootstrap():
    logger.info("--- BOOTSTRAP INITIATED ---")
    service = PersistenceService()
    try:
        service.seed_country_reference()

        logger.info("BOOTSTRAP: Checking for holidays (Rolling 1-Year Window)...")
        # UPDATED: Removed 'year' argument
        holidays = scrape_holidays()
        if holidays:
            service.upsert_holidays(holidays)

        logger.info("BOOTSTRAP: Running immediate scrape to populate DB...")
        execute_scrape_job("BOOTSTRAP")

        logger.info("BOOTSTRAP: Scanning DB for event times (Window: Today + Tomorrow)...")
        today = date.today()
        tomorrow = today + timedelta(days=1)
        target_dates = [today.strftime("%Y-%m-%d"), tomorrow.strftime("%Y-%m-%d")]

        records = service.session.query(EventRecord).filter(
            EventRecord.date.in_(target_dates),
            EventRecord.time_str.like("%:%")
        ).all()

        dt_list = []
        for r in records:
            try:
                full_dt = datetime.strptime(f"{r.date} {r.time_str}", "%Y-%m-%d %H:%M")
                if full_dt > datetime.now() - timedelta(minutes=10):
                    dt_list.append(full_dt)
            except:
                continue

        logger.info(f"BOOTSTRAP: Found {len(dt_list)} raw events. Calculating consolidated Dynamic schedule...")
        schedule_dynamic_jobs(dt_list)

        log_full_schedule_report()

    except Exception as e:
        logger.error(f"BOOTSTRAP FAILED: {e}", exc_info=True)
    finally:
        service.close()
        logger.info("--- BOOTSTRAP COMPLETE ---")


if __name__ == "__main__":
    init_db()
    scheduler.start()
    logger.info("SCHEDULER STARTED. Press Ctrl+C to exit.")

    scheduler.add_job(
        execute_scrape_job,
        'interval',
        minutes=15,
        jitter=180,
        args=['PATROL'],
        id='patrol_routine',
        replace_existing=True
    )

    scheduler.add_job(
        run_bootstrap,
        'cron',
        hour=0,
        minute=5,
        id='daily_bootstrap',
        replace_existing=True
    )

    run_bootstrap()

    try:
        while True:
            time.sleep(1)
    except (KeyboardInterrupt, SystemExit):
        logger.info("Shutting down scheduler...")
        scheduler.shutdown()

