# --- Holiday Page Callback (FIXED CURRENCY MAPPING) ---
@app.callback(
    Output("holidays-grid-container", "children"),
    [Input("holiday-date-filter", "start_date"), Input("holiday-date-filter", "end_date")]
)
def update_holidays(start_date, end_date):
    session = SessionLocal()
    try:
        query = session.query(HolidayRecord)
        if start_date: query = query.filter(HolidayRecord.date_str >= start_date)
        if end_date: query = query.filter(HolidayRecord.date_str <= end_date)

        query = query.order_by(HolidayRecord.date_str.asc())
        df = pd.read_sql(query.statement, session.bind)

        if not df.empty:
            # --- ADDED CURRENCY MAPPING HERE ---
            country_refs = session.query(CountryReference).all()
            country_map = {c.country_name.strip().lower(): c.currency for c in country_refs}

            def safe_map(country_name):
                if not country_name: return "UNK"
                key = str(country_name).strip().lower()
                return country_map.get(key, country_name)  # Fallback to country name

            # Create the 'currency' column used by create_holidays_grid
            df['currency'] = df['country'].apply(safe_map)

        return create_holidays_grid(df)
    except Exception as e:
        logger.error(f"Holiday Grid Error: {e}")
        return dbc.Alert(f"Error loading holidays: {e}", color="danger")
    finally:
        session.close()


