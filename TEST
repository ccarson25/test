import uuid
import logging
from datetime import datetime
from sqlalchemy import select, func
from sqlalchemy.dialects.sqlite import insert
from sqlalchemy.exc import SQLAlchemyError
from typing import List, Dict, Any, Tuple

from database import SessionLocal
from models import EventRecord, AuditLog, JobLog, HolidayRecord, CountryReference

logger = logging.getLogger(__name__)


class PersistenceService:
    def __init__(self):
        self.session = SessionLocal()

    def upsert_events_with_audit(self, events_data: List[Dict[str, Any]], trigger_reason: str = "MANUAL") -> Tuple[
        str, List[datetime]]:
        run_id = str(uuid.uuid4())
        added_count = 0
        updated_count = 0
        omitted_count = 0
        new_times_found = []

        if not events_data:
            self._log_job_end(run_id, "SUCCESS", 0, 0, 0, trigger_reason=trigger_reason)
            return run_id, []

        try:
            incoming_pids = [str(e['pid']) for e in events_data]
            existing_records = self.session.query(EventRecord).filter(EventRecord.pid.in_(incoming_pids)).all()
            existing_map = {rec.pid: rec for rec in existing_records}

            for row in events_data:
                pid = str(row['pid'])

                clean_data = {
                    "date": row.get("date", ""),
                    "time_str": row.get("time_raw", ""),
                    "currency": row.get("currency", ""),
                    "title": row.get("title", ""),
                    "impact": row.get("impact_raw", "1"),
                    "actual": str(row.get("actual", "")).strip(),
                    "forecast": str(row.get("forecast", "")).strip(),
                    "previous": str(row.get("previous", "")).strip(),
                    "source": row.get("source", "Investing.com"),
                    "source_url": row.get("source_url", "https://uk.investing.com/economic-calendar")
                }

                if pid not in existing_map:
                    record = EventRecord(pid=pid, **clean_data)
                    self.session.add(record)
                    self.session.add(AuditLog(
                        event_pid=pid, change_type="INSERT", field_changed="ALL",
                        old_value=None, new_value="Created", job_run_id=run_id
                    ))
                    added_count += 1
                else:
                    record = existing_map[pid]
                    changes_found = False

                    if record.source != clean_data['source']:
                        record.source = clean_data['source']
                    if record.source_url != clean_data['source_url']:
                        record.source_url = clean_data['source_url']

                    audit_fields = ['actual', 'forecast', 'previous', 'time_str', 'impact', 'title']

                    for field in audit_fields:
                        old_val = getattr(record, field) or ""
                        new_val = clean_data[field]

                        if old_val != new_val:
                            if field == 'time_str':
                                if (not old_val or ":" not in old_val) and (":" in new_val):
                                    try:
                                        today_str = clean_data['date']
                                        full_dt_str = f"{today_str} {new_val}"
                                        new_dt = datetime.strptime(full_dt_str, "%Y-%m-%d %H:%M")
                                        new_times_found.append(new_dt)
                                    except ValueError:
                                        pass

                            changes_found = True
                            c_type = "UPDATE"
                            if field == 'actual':
                                if not old_val and new_val:
                                    c_type = "RELEASE"
                                elif old_val and new_val:
                                    c_type = "REVISION"
                            elif field in ['previous', 'forecast'] and old_val and new_val:
                                c_type = "REVISION"

                            self.session.add(AuditLog(
                                event_pid=pid, change_type=c_type, field_changed=field,
                                old_value=old_val, new_value=new_val, job_run_id=run_id
                            ))
                            setattr(record, field, new_val)

                    if record.currency != clean_data['currency']:
                        record.currency = clean_data['currency']
                        changes_found = True

                    if changes_found:
                        record.last_updated = datetime.utcnow()
                        updated_count += 1
                    else:
                        omitted_count += 1

            self.session.commit()
            self._log_job_end(run_id, "SUCCESS", added_count, updated_count, omitted_count,
                              trigger_reason=trigger_reason)
            logger.info(
                f"Job {run_id} ({trigger_reason}) Complete: Added {added_count}, Updated {updated_count}, Omitted {omitted_count}")

            return run_id, new_times_found

        except Exception as e:
            self.session.rollback()
            self._log_job_end(run_id, "FAILED", added_count, updated_count, omitted_count, str(e),
                              trigger_reason=trigger_reason)
            logger.error(f"Job {run_id} Failed: {e}")
            raise

    def upsert_holidays(self, holidays_data: List[Dict[str, Any]]):
        if not holidays_data: return
        try:
            clean_records = []
            for item in holidays_data:
                if not item.get("date"): continue

                status_val = item.get("time", "")
                if not status_val:
                    status_val = "Closed"

                clean_records.append({
                    "pid": item["pid"],
                    "date_str": item["date"],
                    "country": item["country"],
                    "market": item["market"],
                    "title": item["title"],
                    "status": status_val,
                    "source": item.get("source", "Investing.com"),
                    "source_url": item.get("source_url", "https://uk.investing.com/holiday-calendar/")
                })

            stmt = insert(HolidayRecord).values(clean_records)
            stmt = stmt.on_conflict_do_update(
                index_elements=['pid'],
                set_={
                    "status": stmt.excluded.status,
                    "last_seen_utc": func.now(),
                    "source": stmt.excluded.source,
                    "source_url": stmt.excluded.source_url
                }
            )
            self.session.execute(stmt)
            self.session.commit()
            logger.info(f"Upserted {len(clean_records)} holidays.")
        except SQLAlchemyError as e:
            self.session.rollback()
            logger.error(f"DB Error (Holidays): {e}")

