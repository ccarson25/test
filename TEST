import requests
from requests.adapters import HTTPAdapter
from urllib3.util.retry import Retry
from bs4 import BeautifulSoup
import time
import random
import sys
import os
from datetime import datetime, date, timedelta
from typing import List, Dict, Any, Tuple

try:
    from .default_logger import get_logger
except ImportError:
    from default_logger import get_logger

logger = get_logger(__name__)

# --- CONFIGURATION ---
DEFAULT_TIMEOUT = 30
MAX_RETRIES = 3
BACKOFF_FACTOR = 1
STATUS_FORCELIST = [403, 429, 500, 502, 503, 504]


def get_robust_session() -> requests.Session:
    """Creates a session with retry logic and standard browser headers."""
    session = requests.Session()
    session.headers.update({
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/121.0.0.0 Safari/537.36",
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
        "Accept-Language": "en-US,en;q=0.9",
        "Origin": "https://www.investing.com",
        "Referer": "https://www.investing.com/holiday-calendar/"
    })

    retry_strategy = Retry(
        total=MAX_RETRIES,
        backoff_factor=BACKOFF_FACTOR,
        status_forcelist=STATUS_FORCELIST,
        allowed_methods=["POST", "GET"]
    )
    adapter = HTTPAdapter(max_retries=retry_strategy)
    session.mount("https://", adapter)
    session.mount("http://", adapter)
    return session


def parse_investing_date(date_str: str) -> str:
    """Parses dates like 'Jan 01, 2026' -> '2026-01-01'."""
    clean_str = date_str.strip()
    try:
        # Format: Jan 01, 2026
        dt = datetime.strptime(clean_str, "%b %d, %Y")
        return dt.strftime("%Y-%m-%d")
    except ValueError:
        pass
    try:
        # Format: Monday, January 1, 2026
        dt = datetime.strptime(clean_str, "%A, %B %d, %Y")
        return dt.strftime("%Y-%m-%d")
    except ValueError:
        pass
    return ""


def get_date_chunks(start_date: date, end_date: date, chunk_days: int = 30) -> List[Tuple[str, str]]:
    """
    Splits a large date range into smaller chunks (e.g., 30 days) to bypass pagination limits.
    Returns a list of (start_str, end_str) tuples.
    """
    chunks = []
    current = start_date
    while current < end_date:
        chunk_end = min(current + timedelta(days=chunk_days), end_date)
        chunks.append((current.strftime("%Y-%m-%d"), chunk_end.strftime("%Y-%m-%d")))
        # Move to next day after chunk_end to avoid overlap
        current = chunk_end + timedelta(days=1)
    return chunks


def scrape_holidays() -> List[Dict[str, Any]]:
    """
    Scrapes market holidays using DATE CHUNKING.
    Instead of asking for a full year and failing to paginate,
    we ask for 30 days at a time.
    """

    # 1. Define Range: Today - 10 days to + 365 days
    today = date.today()
    start_date = today - timedelta(days=10)
    end_date = start_date + timedelta(days=365)

    # 2. Split into 1-month chunks
    date_chunks = get_date_chunks(start_date, end_date, chunk_days=30)

    base_url = "https://www.investing.com/holiday-calendar/"
    ajax_url = "https://www.investing.com/holiday-calendar/Service/getCalendarFilteredData"

    post_headers = {
        "X-Requested-With": "XMLHttpRequest",
        "Content-Type": "application/x-www-form-urlencoded",
    }

    session = get_robust_session()
    all_holidays = []

    logger.info(f"--- Starting Holiday Scrape ({start_date} to {end_date}) ---")
    logger.info(f"Strategy: Date Chunking ({len(date_chunks)} chunks of ~30 days)")

    # 3. Warm up session
    try:
        session.get(base_url, timeout=DEFAULT_TIMEOUT)
        time.sleep(1)
    except Exception as e:
        logger.warning(f"Session warm-up warning: {e}")

    # 4. Iterate Chunks
    for i, (chunk_start, chunk_end) in enumerate(date_chunks):

        # We assume 1 page is enough for 30 days of holidays globally.
        # If a single month ever has >256 holidays, we might need smaller chunks.
        payload = {
            "dateFrom": chunk_start,
            "dateTo": chunk_end,
            "country": "",
            "currentTab": "custom",
            "limit_from": "0",  # Always start at 0 for this specific date chunk
            "showMore": "false",
            "submitFilters": "1",
            "byHandler": "true"
        }

        try:
            logger.info(f"Fetching Chunk {i + 1}/{len(date_chunks)}: {chunk_start} to {chunk_end}...")
            response = session.post(ajax_url, data=payload, headers=post_headers, timeout=DEFAULT_TIMEOUT)
            response.raise_for_status()

            data_json = response.json()
            html_fragment = data_json.get('data', '')

            if not html_fragment or "No results found" in html_fragment:
                logger.info(f"Chunk {i + 1}: No holidays found.")
                continue

            soup = BeautifulSoup(html_fragment, 'html.parser')
            rows = soup.find_all("tr")

            current_sticky_date = ""
            rows_found_in_chunk = 0

            for row in rows:
                tds = row.find_all("td")
                if not tds:
                    continue

                # Detect Date (Sticky Header)
                first_cell_text = tds[0].get_text(strip=True)
                possible_date = parse_investing_date(first_cell_text)

                if possible_date:
                    current_sticky_date = possible_date
                    data_cells = tds[1:]
                else:
                    data_cells = tds

                if len(data_cells) < 3:
                    continue

                country = data_cells[0].get_text(strip=True)
                market = data_cells[1].get_text(strip=True)
                title = data_cells[2].get_text(strip=True)

                status = "Closed"
                if len(data_cells) > 3:
                    status = data_cells[3].get_text(strip=True)

                if not current_sticky_date:
                    continue

                pid = f"{current_sticky_date}-{country}-{market}-{title}".replace(" ", "-").lower()

                all_holidays.append({
                    "pid": pid,
                    "date": current_sticky_date,
                    "country": country,
                    "market": market,
                    "title": title,
                    "time": status,
                    "source": "Investing.com",
                    "source_url": "https://uk.investing.com/holiday-calendar/"
                })
                rows_found_in_chunk += 1

            logger.info(f"Chunk {i + 1}: Parsed {rows_found_in_chunk} holidays.")

            # Gentle sleep between chunks
            time.sleep(random.uniform(1.5, 3.0))

        except Exception as e:
            logger.error(f"Holiday scrape failed on chunk {chunk_start}: {e}")
            # Continue to next chunk even if one fails
            continue

    logger.info(f"Holiday Scrape Complete. Total Holidays Found: {len(all_holidays)}")
    return all_holidays


if __name__ == "__main__":
    # Test Run
    results = scrape_holidays()
    print(f"\nCaptured {len(results)} holidays.")

