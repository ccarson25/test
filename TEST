@app.callback(
    [Output("currency-select-all", "value"), Output("currency-select-priority", "value"),
     Output("currency-filter", "value")],
    [Input("currency-select-all", "value"), Input("currency-select-priority", "value"),
     Input("currency-filter", "value")],
    State("currency-filter", "options")
)
def manage_currency_selection(select_all, select_priority, current_selection, options):
    trigger_id = ctx.triggered_id
    all_values = [opt["value"] for opt in options] if options else []
    priority_values = all_values[:8] if len(all_values) >= 8 else all_values

    if trigger_id == "currency-select-all": return (True, False, all_values) if select_all else (False, False, [])
    if trigger_id == "currency-select-priority": return (False, True, priority_values) if select_priority else (False,
                                                                                                                False,
                                                                                                                [])
    if not current_selection: return False, False, []

    is_all = set(current_selection) == set(all_values)
    is_priority = set(current_selection) == set(priority_values)
    return is_all, is_priority, dash.no_update


@app.callback(
    Output("calendar-grid-container", "children"),
    [Input("date-filter", "start_date"), Input("date-filter", "end_date"), Input("currency-filter", "value"),
     Input("impact-filter", "value")]
)
def update_events_grid(start_date, end_date, currencies, impacts):
    session = SessionLocal()
    try:
        # 1. FETCH EVENTS
        query = session.query(EventRecord)
        if start_date: query = query.filter(EventRecord.date >= start_date)
        if end_date: query = query.filter(EventRecord.date <= end_date)
        if currencies: query = query.filter(EventRecord.currency.in_(currencies))
        if impacts: query = query.filter(EventRecord.impact.in_(impacts))

        query = query.order_by(EventRecord.date.asc(), EventRecord.time_str.asc())
        df_events = pd.read_sql(query.statement, session.bind)

        # 2. FETCH HOLIDAYS
        hol_query = session.query(HolidayRecord)
        if start_date: hol_query = hol_query.filter(HolidayRecord.date_str >= start_date)
        if end_date: hol_query = hol_query.filter(HolidayRecord.date_str <= end_date)

        df_holidays = pd.read_sql(hol_query.statement, session.bind)

        # 3. PROCESS & MERGE (Robust Mapping)
        if not df_holidays.empty:
            country_refs = session.query(CountryReference).all()
            country_map = {c.country_name.strip().lower(): c.currency for c in country_refs}

            def safe_map(country_name):
                if not country_name: return "UNK"
                key = str(country_name).strip().lower()
                return country_map.get(key, country_name)

            df_holidays['currency'] = df_holidays['country'].apply(safe_map)

            if currencies:
                df_holidays = df_holidays[df_holidays['currency'].isin(currencies)]

            if not df_holidays.empty:
                df_holidays_clean = pd.DataFrame({
                    "date": df_holidays['date_str'],
                    "time_str": "All Day",
                    "currency": df_holidays['currency'],
                    "impact": "Holiday",
                    "title": "Holiday: " + df_holidays['title'],
                    "actual": "", "forecast": "", "previous": "",
                    "source": df_holidays['source'],
                    "source_url": df_holidays['source_url']
                })

                if df_events.empty:
                    df_events = df_holidays_clean
                else:
                    df_events = pd.concat([df_events, df_holidays_clean], ignore_index=True)

        if df_events.empty:
            return html.Div(dbc.Alert("No events found matching these filters.", color="info"), className="p-4")

        return create_events_grid(df_events)
    except Exception as e:
        logger.error(f"Grid Update Error: {e}", exc_info=True)
        return dbc.Alert(f"Error: {e}", color="danger")
    finally:
        session.close()


