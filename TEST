    if not df.empty:
        # SMART DATE SORT LOGIC
        # If time is 'All Day', treat it as '00:00' so it sorts to the top of the day.
        df['sort_time'] = df['time_str'].apply(lambda x: "00:00" if x == "All Day" else x)
